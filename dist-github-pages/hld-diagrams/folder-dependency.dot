digraph FolderDependencies {
    rankdir="LR";
    graph [fontsize=10, fontname="Arial"];
    node [shape=box, style="rounded", fontsize=10, fontname="Arial"];
    edge [fontsize=9, fontname="Arial"];

    "controls";
    "debug";
    "engine";
    "geometry";
    "interaction";
    "light";
    "loaders";
    "material";
    "math";
    "render";
    "scene";
    "shader";
    "texture";

    "controls" -> "math";
    "controls" -> "scene";
    "debug" -> "geometry";
    "debug" -> "light";
    "debug" -> "material";
    "debug" -> "math";
    "debug" -> "scene";
    "engine" -> "geometry";
    "engine" -> "material";
    "engine" -> "render";
    "engine" -> "scene";
    "geometry" -> "math";
    "interaction" -> "math";
    "interaction" -> "scene";
    "light" -> "scene";
    "loaders" -> "geometry";
    "loaders" -> "material";
    "loaders" -> "math";
    "loaders" -> "scene";
    "loaders" -> "texture";
    "material" -> "shader";
    "material" -> "texture";
    "render" -> "geometry";
    "render" -> "light";
    "render" -> "material";
    "render" -> "math";
    "render" -> "scene";
    "scene" -> "geometry";
    "scene" -> "material";
    "scene" -> "math";
    "shader" -> "texture";
}
