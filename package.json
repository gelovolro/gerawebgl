{
  "name": "gerawebgl",
  "version": "0.1.0-dev.20260201013503",
  "description": "Gera WebGL, browser 3D engine using WebGL 2.0",
  "scripts": {
    "ensure:docs-jsdoc-dir": "node -e \"require('fs').mkdirSync('docs/latest-jsdoc-generation',{recursive:true})\"",
    "ensure:docs-hld-diagrams-dir": "node -e \"require('fs').mkdirSync('docs/hld-component-diagrams',{recursive:true})\"",
    "ensure:dist": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "ensure:github-pages-root-dir": "node -e \"require('fs').mkdirSync('dist-github-pages',{recursive:true})\"",
    "ensure:github-pages-demo-dir": "node -e \"require('fs').mkdirSync('dist-github-pages/demos',{recursive:true})\"",
    "ensure:github-pages-demo-assets-dir": "node -e \"require('fs').mkdirSync('dist-github-pages/demos/assets',{recursive:true})\"",
    "ensure:github-pages-api-dir": "node -e \"require('fs').mkdirSync('dist-github-pages/api',{recursive:true})\"",
    "ensure:github-pages-hld-diagrams-dir": "node -e \"require('fs').mkdirSync('dist-github-pages/hld-diagrams',{recursive:true})\"",
    "clear:dist": "rimraf dist",
    "clear:github-pages-root-dir": "rimraf dist-github-pages",
    "copy:dist-to-github-pages": "npm run ensure:github-pages-demo-dir && copyfiles -f \"dist/gerawebgl.*\" dist-github-pages/demos",
    "copy:github-pages-index-template": "npm run ensure:github-pages-root-dir && copyfiles -f \"templates/gh-pages-index.html\" dist-github-pages && node -e \"require('fs').renameSync('dist-github-pages/gh-pages-index.html','dist-github-pages/index.html')\"",
    "copy:demo-scripts": "npm run ensure:github-pages-demo-dir && copyfiles -f \"demo-sources/**/*\" dist-github-pages/demos",
    "copy:demo-assets": "npm run ensure:github-pages-demo-assets-dir && copyfiles -u 1 \"demo-assets/**/*\" dist-github-pages/demos/assets",
    "copy:demo:all": "npm run copy:demo-scripts && npm run copy:demo-assets",
    "copy:docs-jsdoc-to-github-pages": "npm run ensure:github-pages-api-dir && copyfiles -u 2 \"docs/latest-jsdoc-generation/**/*\" dist-github-pages/api",
    "copy:docs-hld-diagrams-to-github-pages": "npm run ensure:github-pages-hld-diagrams-dir && copyfiles -u 2 \"docs/hld-component-diagrams/**/*\" dist-github-pages/hld-diagrams",
    "copy:full-docs-to-github-pages": "npm run copy:docs-jsdoc-to-github-pages && npm run copy:docs-hld-diagrams-to-github-pages",
    "copy:all": "npm run copy:demo:all && npm run copy:dist-to-github-pages && npm run copy:full-docs-to-github-pages && npm run copy:github-pages-index-template",
    "github-pages:serve-locally": "http-server dist-github-pages -p 9090 -c-1",
    "docs:build:jsdoc-only": "jsdoc -c jsdoc.json -R readme.md",
    "docs:build-locally": "npm run ensure:docs-jsdoc-dir && npm run ensure:docs-hld-diagrams-dir && npm run deps:check && npm run deps:generate:diagrams && npm run docs:build:jsdoc-only",
    "docs:serve": "http-server docs -p 9091 -c-1",
    "docs:build-and-serve": "npm run docs:build-locally && npm run docs:serve",
    "build:lib:debug": "npm run ensure:dist && esbuild core/library.js --bundle --format=esm --sourcemap --outfile=dist/gerawebgl.js",
    "build:lib:release": "npm run ensure:dist && esbuild core/library.js --bundle --minify --format=esm --outfile=dist/gerawebgl.min.js",
    "build:lib:all": "npm run build:lib:debug && npm run build:lib:release",
    "build:dist": "npm run clear:dist && npm run build:lib:all",
    "build:dist-github-pages": "npm run clear:github-pages-root-dir && npm run build:dist && npm run docs:build-locally && npm run copy:all",
    "build:local-dev-stand-and-serve": "npm run build:dist-github-pages && npm run github-pages:serve-locally",
    "build": "npm run build:dist-github-pages",
    "prepack": "npm run build:dist",
    "lint": "eslint core tests *.mjs",
    "dev": "npm run build:local-dev-stand-and-serve",
    "serve": "npm run github-pages:serve-locally",
    "clear:zip": "rimraf *.zip",
    "create:zip-full": "npm run clear:zip && zip -r \"gerawebgl-full-sources-$(date +%d%m%y%H%M%S).zip\" . -x \"*.zip\" \"*.tgz\" \"node_modules/*\" \".git/*\"",
    "create:zip-lite": "npm run clear:zip && zip -r \"gerawebgl-lite-sources-$(date +%d%m%y%H%M%S).zip\" . -x \"*.zip\" \"*.tgz\" \"node_modules/*\" \".git/*\" \"demo-assets/*\" \"dist-github-pages/*\" \"docs/*\"",
    "deps:check": "depcruise core --include-only '^core'",
    "deps:showgraph:raw": "depcruise core --include-only '^core' --output-type mermaid",
    "deps:generate:diagrams": "node ./render-dependency-graph.mjs",
    "test:unit": "node --test tests/unit/**/*.tests.mjs",
    "test:unit:coverage": "node --test --experimental-test-coverage --test-coverage-include=core/**/*.js --test-coverage-exclude=tests/**/*.mjs tests/unit/**/*.tests.mjs",
    "test:smoke:oneshot": "node --test tests/smoke/scripts-one-shot.test.mjs",
    "test:smoke:serve": "node --test tests/smoke/scripts-serve.test.mjs",
    "test:smoke": "npm run test:smoke:oneshot && npm run test:smoke:serve",
    "test": "npm run lint -- --debug && npm run test:unit:coverage && npm run test:smoke",
    "git:restore:generated": "git restore -- dist dist-github-pages docs",
    "package-version:update": "node update-package-version.mjs --action=update",
    "package-version:rollback": "node update-package-version.mjs --action=rollback"
  },
  "keywords": [
    "gera",
    "gerawebgl",
    "webgl",
    "webgl2",
    "3d",
    "engine",
    "renderer",
    "obj",
    "mtl"
  ],
  "author": "gelovolro",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "copyfiles": "^2.4.1",
    "dependency-cruiser": "^17.3.8",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.5",
    "rimraf": "^6.1.2"
  },
  "type": "module",
  "main": "./dist/gerawebgl.js",
  "module": "./dist/gerawebgl.js",
  "exports": {
    ".": "./dist/gerawebgl.js",
    "./min": "./dist/gerawebgl.min.js"
  },
  "unpkg": "./dist/gerawebgl.min.js",
  "jsdelivr": "./dist/gerawebgl.min.js",
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gelovolro/gerawebgl.git"
  },
  "homepage": "https://github.com/gelovolro/gerawebgl",
  "bugs": {
    "url": "https://github.com/gelovolro/gerawebgl/issues"
  }
}
