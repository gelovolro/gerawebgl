{
  "name": "gerawebgl",
  "version": "0.1.0-dev.20260201013503",
  "description": "Gera WebGL, browser 3D engine using WebGL 2.0",
  "scripts": {
    "ensure:dist": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
    "ensure:demo-dir": "node -e \"require('fs').mkdirSync('docs/demo',{recursive:true})\"",
    "ensure:demo-assets-dir": "node -e \"require('fs').mkdirSync('docs/demo/assets',{recursive:true})\"",
    "clear:dist": "rimraf dist",
    "clear:github-pages-rootdir": "rimraf docs",
    "clear:github-pages-demodir": "rimraf docs/demo",
    "copy:dist-to-demo": "npm run ensure:demo-dir && copyfiles -f \"dist/gerawebgl.*\" docs/demo",
    "copy:demo-assets": "npm run ensure:demo-assets-dir && copyfiles -u 1 \"assets/**/*\" docs/demo/assets",
    "copy:demo-scripts": "npm run ensure:demo-dir && copyfiles -f \"demo/**/*\" docs/demo",
    "copy:demo:all": "npm run copy:demo-scripts && npm run copy:demo-assets",
    "copy:all": "npm run copy:demo:all && npm run copy:dist-to-demo",
    "demo:serve": "http-server docs/demo -p 9090 -c-1",
    "docs:build": "jsdoc -c jsdoc.json",
    "docs:serve": "http-server docs -p 9091 -c-1",
    "docs:build-and-serve": "npm run docs:build && npm run docs:serve",
    "build:lib:debug": "npm run ensure:dist && esbuild core/library.js --bundle --format=esm --sourcemap --outfile=dist/gerawebgl.js",
    "build:lib:release": "npm run ensure:dist && esbuild core/library.js --bundle --minify --format=esm --outfile=dist/gerawebgl.min.js",
    "build:lib:all": "npm run build:lib:debug && npm run build:lib:release",
    "build:dist": "npm run clear:dist && npm run build:lib:all",
    "build:demo:with-core-update": "npm run clear:github-pages-demodir && npm run build:dist && npm run copy:all",
    "build:all-with-docs": "npm run clear:github-pages-rootdir && npm run docs:build && npm run build:demo:with-core-update",
    "build:core-and-demo-and-serve": "npm run build:demo:with-core-update && npm run demo:serve",
    "dev": "npm run build:core-and-demo-and-serve",
    "clear:zip": "rimraf *.zip",
    "create:zip-full": "npm run clear:zip && zip -r \"gerawebgl-full-sources-$(date +%d%m%y%H%M%S).zip\" . -x \"*.zip\" \"node_modules/*\" \".git/*\"",
    "create:zip-lite": "npm run clear:zip && zip -r \"gerawebgl-lite-sources-$(date +%d%m%y%H%M%S).zip\" . -x \"*.zip\" \"node_modules/*\" \".git/*\" \"assets/*\" \"docs/*\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "gera",
    "gerawebgl",
    "webgl",
    "webgl2",
    "3d",
    "engine",
    "renderer",
    "obj",
    "mtl"
  ],
  "author": "gelovolro",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jsdoc": "^4.0.5",
    "rimraf": "^6.1.2"
  },
  "type": "module",
  "main": "./dist/gerawebgl.js",
  "module": "./dist/gerawebgl.js",
  "exports": {
    ".": "./dist/gerawebgl.js",
    "./min": "./dist/gerawebgl.min.js"
  },
  "unpkg": "./dist/gerawebgl.min.js",
  "jsdelivr": "./dist/gerawebgl.min.js",
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gelovolro/gerawebgl.git"
  },
  "homepage": "https://github.com/gelovolro/gerawebgl",
  "bugs": {
    "url": "https://github.com/gelovolro/gerawebgl/issues"
  }
}
